{
  "name": "git-hex",
  "title": "Git Hex",
  "version": "0.1.0",
  "description": "AI-assisted, non-interactive git refactoring via MCP for agents or chat users invoking the tools",
  "websiteUrl": "https://github.com/yaniv-golan/git-hex",
  "icons": [
    {
      "src": "../assets/icons/git-hex.svg"
    }
  ],
  "env": {
    "MCPBASH_TOOL_ENV_MODE": "allowlist",
    "MCPBASH_TOOL_ENV_ALLOWLIST": "GIT_HEX_DEBUG,GIT_HEX_DEBUG_SPLIT,GIT_HEX_DEBUG_REBASE"
  },
  "mcpBash": {
    "apiVersion": 2
  }
}
